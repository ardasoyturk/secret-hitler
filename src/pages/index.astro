---
import "../styles/global.css";
import { Game } from "../components/game/Game";
import { getImage } from "astro:assets";
import type { ImageMetadata } from "astro";
import { pwaInfo } from "virtual:pwa-info";

const rawAssets = import.meta.glob("../assets/**/*.{png,jpg,jpeg}", {
  eager: true,
  import: "default",
}) as Record<string, ImageMetadata>;

const optimizedAssets = Object.fromEntries(
  await Promise.all(
    Object.entries(rawAssets).map(async ([path, image]) => {
      const transformed = await getImage({
        src: image,
        format: "webp",
        quality: 82,
      });

      return [path.replace("../assets/", ""), transformed.src] as const;
    }),
  ),
);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/icons/icon-192.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no, viewport-fit=cover" />
    <meta name="theme-color" content="#2a2118" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="description" content="Secret Hitler — Pass & Play Edition. A single-device board game for 5-10 players." />
    {pwaInfo?.webManifest?.linkTag && <Fragment set:html={pwaInfo.webManifest.linkTag} />}
    <title>Secret Hitler — Pass & Play</title>
  </head>
  <body class="noise-overlay">
    <div id="app">
      <Game client:only="react" optimizedAssets={optimizedAssets} />
    </div>
    <noscript>
      <div style="display:flex;align-items:center;justify-content:center;min-height:100dvh;padding:2rem;text-align:center;color:#bbb;">
        <p>JavaScript is required to play Secret Hitler.</p>
      </div>
    </noscript>
    <script>
      import "../pwa";
    </script>
  </body>
</html>
